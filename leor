  state.horses.push(name);
  inp.value = '';
  renderHorseList(); render(); saveToStorage();
}

function removeHorse(h) {
  if (!confirm('למחוק את ' + h + '?')) return;
  state.horses = state.horses.filter(x => x !== h);
  state.injured = state.injured.filter(x => x !== h);
  DAYS.forEach(d => {
    Object.values(state.schedule[d] || {}).forEach(slots => {
      if (!slots) return;
      const i = slots.indexOf(h);
      if (i !== -1) slots[i] = '';
    });
  });
  renderHorseList(); render(); saveToStorage();
}

function markInjured(h) {
  if (!state.injured.includes(h)) state.injured.push(h);
  DAYS.forEach(d => {
    Object.values(state.schedule[d] || {}).forEach(slots => {
      if (!slots) return;
      const i = slots.indexOf(h);
      if (i !== -1) slots[i] = '';
    });
  });
  renderHorseList(); render(); saveToStorage();
}

function recoverHorse(h) {
  state.injured = state.injured.filter(x => x !== h);
  renderHorseList(); render(); saveToStorage();
}

function addInstructor() {
  const inp = document.getElementById('newInstName');
  const name = inp.value.trim();
  if (!name || state.instructors.includes(name)) return;
  state.instructors.push(name);
  inp.value = '';
  renderInstList(); render(); saveToStorage();
}

function removeInst(inst) {
  if (!confirm('למחוק את ' + inst + '?')) return;
  state.instructors = state.instructors.filter(x => x !== inst);
  DAYS.forEach(d => { if (state.schedule[d]) delete state.schedule[d][inst]; });
  renderInstList(); render(); saveToStorage();
}

