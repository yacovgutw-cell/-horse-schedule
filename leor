function renderWeekView() {
  const el = document.getElementById('weekViewContent');
  const days = ['א','ב','ג','ד','ה','ו'];
  
  let html = '<div id="weekPrintArea" style="background:#fff;border-radius:10px;padding:16px;direction:rtl">';
  html += '<div style="text-align:center;font-size:20px;font-weight:700;color:#1F3864;margin-bottom:14px;border-bottom:3px solid #1F3864;padding-bottom:8px">&#127863; לוח שיבוץ סוסים — שבועי</div>';
  
  // Big schedule table
  html += '<table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:18px">';
  // Header row - instructors
  html += '<tr><th style="background:#1F3864;color:#fff;padding:7px 6px;border:1px solid #2F4F8F;min-width:50px">יום</th>';
  html += '<th style="background:#8B0000;color:#fff;padding:7px 6px;border:1px solid #8B0000;min-width:100px">רזרבה</th>';
  state.instructors.forEach(inst => {
    html += `<th style="background:#2F4F8F;color:#fff;padding:7px 6px;border:1px solid #1F3864;min-width:80px">${inst}</th>`;
  });
  html += '</tr>';
  
  days.forEach(day => {
    const sched = state.schedule[day] || {};
    const assigned = getAssigned(day);
    const reserve = state.horses.filter(h => !assigned.has(h) && !state.injured.includes(h));
    const dups = getDups(day);
    const dupHorses = new Set(dups.map(([h]) => h));
    const offList = [];
    state.instructors.forEach(inst => { if(isOff(inst, day)) offList.push(inst); });
    
    // 3 sub-rows per day
    for (let slot = 0; slot < 3; slot++) {
      html += '<tr>';
      if (slot === 0) {
        html += `<td rowspan="3" style="background:#4472C4;color:#fff;font-size:18px;font-weight:700;text-align:center;padding:8px;border:1px solid #2F4F8F;vertical-align:middle">${day}</td>`;
        // Reserve cell - rowspan 3
        const reserveText = reserve.join(' | ') || '—';
        html += `<td rowspan="3" style="background:#FFF3CD;color:#7F5000;padding:6px;border:1px solid #FAC775;vertical-align:top;font-size:11px;font-weight:600">${reserveText}</td>`;
      }
      state.instructors.forEach(inst => {
        if (slot === 0 && isOff(inst, day)) {
          html += `<td rowspan="3" style="background:#111;border:1px solid #333;text-align:center;color:#444;font-size:10px;vertical-align:middle">לא עובד</td>`;
          return;
        }
        if (isOff(inst, day)) return;
        const slots = sched[inst] || [];
        const horse = slots[slot] || '';
        const isDup = horse && dupHorses.has(horse);
        const isInj = horse && state.injured.includes(horse);
        let bg = slot === 0 ? '#fff' : slot === 1 ? '#F0F4FF' : '#E8F0FE';
        let color = '#1F3864';
        if (isDup) { bg = '#FCEBEB'; color = '#A32D2D'; }
        if (isInj) { bg = '#FCEBEB'; color = '#A32D2D'; }
        if (!horse) { bg = '#fafafa'; color = '#ccc'; }
        html += `<td style="background:${bg};color:${color};padding:5px 6px;border:0.5px solid #ddd;font-weight:${horse ? '700' : '400'};font-size:12px;text-align:center">${horse || (slot===0 ? '·' : '')}</td>`;
      });
      html += '</tr>';
    }
    // Thick bottom border row
    html += `<tr><td colspan="${state.instructors.length + 2}" style="padding:0;border-bottom:2px solid #2F4F8F;border-top:0;border-left:0;border-right:0"></td></tr>`;
  });
  html += '</table>';
  
  // Injured horses
  if (state.injured.length > 0) {
    html += `<div style="background:#FCEBEB;border:1px solid #F7C1C1;border-radius:6px;padding:8px 12px;margin-bottom:14px;font-size:12px;color:#A32D2D;font-weight:700">&#129657; סוסים פצועים: ${state.injured.join(' | ')}</div>`;
  }
  
  // Workload table
  html += '<div style="font-size:14px;font-weight:700;color:#1F3864;margin-bottom:8px">&#128200; עומס עבודה שבועי</div>';
  html += '<table style="width:100%;border-collapse:collapse;font-size:12px">';
  html += '<tr><th style="background:#1F3864;color:#fff;padding:6px;border:1px solid #2F4F8F">סוס</th>';
  days.forEach(d => { html += `<th style="background:#2F4F8F;color:#fff;padding:6px;border:1px solid #1F3864;text-align:center">יום ${d}</th>`; });
  html += '<th style="background:#1F3864;color:#fff;padding:6px;border:1px solid #2F4F8F;text-align:center">סה"כ</th></tr>';
  
  state.horses.forEach((horse, hi) => {
    const workedDays = [];
    days.forEach(d => { if(getAssigned(d).has(horse)) workedDays.push(d); });
    const total = workedDays.length;
    const injured = state.injured.includes(horse);
    const countColor = injured ? '#A32D2D' : total >= 5 ? '#C00000' : total >= 3 ? '#BA7517' : '#3B6D11';
    const rowBg = hi % 2 === 0 ? '#fff' : '#F7F9FF';
    html += `<tr><td style="background:${injured ? '#FCEBEB' : rowBg};color:${injured ? '#A32D2D' : '#1F3864'};font-weight:700;padding:5px 8px;border:0.5px solid #ddd">${horse}${injured ? ' 🩹' : ''}</td>`;
    days.forEach(d => {
      const worked = workedDays.includes(d);
      html += `<td style="background:${worked ? '#EAF3DE' : rowBg};color:${worked ? '#3B6D11' : '#ccc'};text-align:center;padding:5px;border:0.5px solid #ddd;font-weight:700">${worked ? '✓' : '—'}</td>`;
    });
    html += `<td style="background:${injured ? '#FCEBEB' : rowBg};color:${countColor};font-weight:700;text-align:center;padding:5px;border:0.5px solid #ddd">${total}</td></tr>`;
  });
  html += '</table>';
  html += '<div style="text-align:center;font-size:10px;color:#aaa;margin-top:12px">הופק: ' + new Date().toLocaleDateString("he-IL") + '</div>';
  html += '</div>';
  el.innerHTML = html;
}

