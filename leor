    html2canvas(el, {scale:2, useCORS:true, backgroundColor:'#ffffff'}).then(canvas => {
      const a = document.createElement('a');
      a.download = 'שיבוץ_' + inst + '_' + new Date().toLocaleDateString('he-IL').replace(/\//g,'-') + '.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
    });
  };
  document.head.appendChild(script);
}

document.getElementById('newHorseName').addEventListener('keydown', e => { if(e.key==='Enter') addHorse(); });
document.getElementById('newInstName').addEventListener('keydown', e => { if(e.key==='Enter') addInstructor(); });
document.getElementById('horseMgmtModal').addEventListener('click', e => { if(e.target === document.getElementById('horseMgmtModal')) closeModal('horseMgmtModal'); });

render();
</script>
